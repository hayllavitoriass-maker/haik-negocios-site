# ---------------------------------------------------------------------------
# HAIK Negócios — variáveis de ambiente
# Copie para `.env.local` (desenvolvimento) ou configure no provedor (produção).
# Nunca commite valores reais.
# ---------------------------------------------------------------------------

# URL pública do site (sem barra final). Usada em canonical, sitemap, Open Graph e e-mails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Segredo da aplicação (>= 32 caracteres aleatórios). Criptografa segredos de MFA e assina tokens.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=

# Banco de dados Postgres (Supabase, Neon, Railway, RDS...). Se vazio, o projeto usa um
# Postgres embutido (PGlite) gravado em ./data/pglite — ideal para desenvolvimento local.
DATABASE_URL=
# Em produção, rode `npm run db:migrate` no deploy. Alternativa: DB_AUTO_MIGRATE=true aplica
# as migrations na primeira conexão do servidor.
DB_AUTO_MIGRATE=false

# Token de uso único para criar o primeiro administrador em /admin/setup.
# Só funciona enquanto não existir nenhum usuário. Remova depois do primeiro acesso.
ADMIN_SETUP_TOKEN=

# Armazenamento de mídia: "local" (disco em ./data/uploads, para VPS/Docker) ou "s3"
# (S3, Cloudflare R2 ou Supabase Storage via protocolo S3 — obrigatório em Vercel/serverless).
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# URL pública base dos arquivos (CDN ou endpoint público do bucket). Se vazio, os arquivos
# são servidos pelo próprio site em /media/*.
S3_PUBLIC_URL=

# E-mail transacional (notificação de novos leads e recuperação de acesso). Opcional.
# Sem SMTP configurado, o link de recuperação é impresso no log do servidor em desenvolvimento.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="HAIK Negócios <contato@exemplo.com.br>"
# Para onde avisar quando chegar um novo diagnóstico ou mensagem (opcional).
NOTIFY_EMAIL=

# Retenção de dados pessoais (LGPD): leads/mensagens encerrados há mais de N dias podem ser
# removidos pelo comando `npm run data:prune`. 0 desativa.
DATA_RETENTION_DAYS=730

# Observação: no modo embutido (sem DATABASE_URL) o banco PGlite só aceita um processo por vez.
# Pare o servidor antes de rodar os scripts `npm run admin:*` e `npm run data:*`.
